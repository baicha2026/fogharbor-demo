# Copy this file to .env. Empty Key is fine for explicit offline demo mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60

BACKEND_URL=http://127.0.0.1:8000
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Optional local ComfyUI. Export custom workflows in API format.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=workflows/reward_api.json
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
COMFYUI_TIMEOUT=120
COMFYUI_POLL_INTERVAL=1

# In-memory, single-process demo limits.
MAX_DEPTH=12
MAX_NODES=80
MAX_SESSIONS=100
SESSION_TTL_SECONDS=7200
